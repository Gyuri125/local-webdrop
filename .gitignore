# ==============================================================================
# Local Webdrop - Git Ignore
# ==============================================================================

# Python Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Packaging & PyInstaller Build Outputs
build/
dist/
*.egg-info/
*.egg
*.spec
!main.spec

# Sensitive Certificates, Private Keys & Tokens (Generated automatically at runtime)
*.pem
*.key
*.crt
*.pfx
*.p12

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# IDEs & Text Editors
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Operating System Specific
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
*.dmp

# App Runtime Outputs & Received Transfers
Webdrop_Received/
Relay_Temp/
Drop_*/
webdrop_package.zip
*.log
*_tisztitott.txt

# Local backup / legacy development folders
régi kódok/